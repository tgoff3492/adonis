rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// Each person owns their users/{uid} tree. Nobody else can read it, except a coach they've linked to,
// who can read it (never change it) for as long as the link exists.
// A coach can write only inside users/{client}/coach/, where coach-set plans, targets and notes go.
//
//   coaches/{uid}            { name, code, created }          a coach's own profile (only they can touch it)
//   invites/{code}           { coach, name, created }         look up a coach by invite code (one at a time, never listed)
//   links/{coachUid_clientUid} { coach, client, coachName, clientName, code, created }
//                            made by the client with a real invite code; either side can delete it to unlink
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    // the signed-in person coaches this user right now
    function coachOf(uid) {
      return signedIn() && exists(/databases/$(database)/documents/links/$(request.auth.uid + '_' + uid));
    }

    match /users/{uid} {
      allow read: if me(uid) || coachOf(uid);
      allow write: if me(uid);
    }
    match /users/{uid}/state/{doc} {
      allow read: if me(uid) || coachOf(uid);
      allow write: if me(uid);
    }
    match /users/{uid}/days/{day} {
      allow read: if me(uid) || coachOf(uid);
      allow write: if me(uid);
    }
    // coach-set plan, targets and note: the coach writes, the client reads and can clear it
    match /users/{uid}/coach/{doc} {
      allow read: if me(uid) || coachOf(uid);
      allow create, update: if coachOf(uid);
      allow delete: if me(uid) || coachOf(uid);
    }

    match /coaches/{uid} {
      allow read, delete: if me(uid);
      allow create, update: if me(uid) && request.resource.data.code is string;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.coach == request.auth.uid;
      allow delete: if signedIn() && resource.data.coach == request.auth.uid;
    }

    match /links/{id} {
      allow read: if signedIn()
        && (resource.data.coach == request.auth.uid || resource.data.client == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.client == request.auth.uid
        && request.resource.data.coach != request.auth.uid
        && id == request.resource.data.coach + '_' + request.auth.uid
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.coach == request.resource.data.coach;
      allow delete: if signedIn()
        && (resource.data.coach == request.auth.uid || resource.data.client == request.auth.uid);
    }
  }
}
